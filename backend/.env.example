# Server Configuration
PORT=3000
BASE_URL="http://localhost:3000"
APP_NAME="Vendor Bridge App"
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
FRONTEND_URL="http://localhost:5173"

# Authentication
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="4h"
PASSWORD_RESET_EXPIRES_MINUTES=10

# Database Configuration (PostgreSQL)
DEV_DB_NAME="vendor_bridge_db"
DEV_DB_USER="postgres"
DEV_DB_PASSWORD="your_postgres_password"
DEV_DB_HOST="localhost"
DEV_DB_PORT=5432
DEV_DB_DIALECT="postgres"

PROD_DB_NAME="vendor_bridge_db_prod"
PROD_DB_USER="postgres"
PROD_DB_PASSWORD="your_postgres_password"
PROD_DB_HOST="localhost"
PROD_DB_PORT=5432
PROD_DB_DIALECT="postgres"

# Mail Configuration
MAIL_FROM_NAME="Vendor Bridge"
MAIL_FROM_ADDRESS="noreply@vendorbridge.com"
DEFAULT_EMAIL_PROVIDER="mailtrap" # 'mailtrap' or 'smtp'

# Mailtrap Credentials (for development)
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_SECURE=false
MAILTRAP_USER="your_mailtrap_user_id"
MAILTRAP_PASSWORD="your_mailtrap_password"

# Google SMTP Credentials (alternative mail provider)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_gmail_username@gmail.com"
SMTP_PASSWORD="your_gmail_app_password"
