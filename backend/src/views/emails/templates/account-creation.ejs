<%- include('../partials/_header.ejs', { title: 'Your Account Has Been Created - VendorBridge' }) %>

            <!-- Body -->
            <tr>
                <td class="body">
                    <h2 class="title">Account Created</h2>

                    <p class="greeting">Hello <%= typeof name !== 'undefined' && name ? name : (typeof vendorname !=='undefined' && vendorname ? vendorname : 'User') %>,</p>

                    <p class="text">
                        Welcome to VendorBridge! Your <%= typeof role !== 'undefined' ? role.replace('_', ' ') : 'user' %> account has been created by the administrator. Here are your credentials to log in:
                    </p>

                    <div class="credentials-box">
                        <div class="credential-row">
                            <span class="credential-label">Role:</span>
                            <span class="credential-value" style="text-transform: uppercase;">
                                <%= typeof role !== 'undefined' ? role.replace('_', ' ') : '' %>
                            </span>
                        </div>
                        <div class="credential-row">
                            <span class="credential-label">Email:</span>
                            <span class="credential-value">
                                <%= typeof email !=='undefined' ? email : '' %>
                            </span>
                        </div>
                        <div class="credential-row">
                            <span class="credential-label">Password:</span>
                            <span class="credential-value">
                                <%= typeof password !=='undefined' ? password : '' %>
                            </span>
                        </div>
                    </div>

                    <p class="text">
                        For security reasons, we recommend that you change your password immediately after logging in
                        for the first time.
                    </p>

                    <div class="btn-container">
                        <a href="<%= typeof loginLink !== 'undefined' ? loginLink : '#' %>" class="btn"
                            target="_blank">Log In to Your Account</a>
                    </div>

                    <div class="divider"></div>

                    <p class="helper-text">
                        If you're having trouble clicking the button, copy and paste the URL below into your web
                        browser:
                    </p>
                    <p class="helper-text" style="margin-top: 6px;">
                        <a href="<%= typeof loginLink !== 'undefined' ? loginLink : '#' %>" class="link-text"
                            target="_blank">
                            <%= typeof loginLink !=='undefined' ? loginLink : '#' %>
                        </a>
                    </p>
                </td>
            </tr>

<%- include('../partials/_footer.ejs', { footerNote: 'This is an automated account setup message from VendorBridge. Please do not reply directly to this email.' }) %>