<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Account Has Been Created - VendorBridge</title>
    <style>
        /* Base reset & styling */
        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            height: 100% !important;
            background-color: #F3F4F5;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #212529;
            line-height: 1.6;
        }

        table {
            border-collapse: collapse;
        }

        img {
            border: 0;
            outline: none;
            text-decoration: none;
        }

        /* Container */
        .wrapper {
            width: 100%;
            table-layout: fixed;
            background-color: #F3F4F5;
            padding: 48px 0;
        }

        .content-table {
            width: 100%;
            max-width: 460px;
            margin: 0 auto;
            background-color: #FFFFFF;
            border-radius: 8px;
            border: 1px solid #E9ECEF;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            text-align: left;
        }

        /* Header */
        .header {
            background-color: #FFFFFF;
            padding: 40px 32px 20px 32px;
            text-align: center;
            border-bottom: 1px solid #E9ECEF;
        }

        .logo-container {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            background-color: #F3F4F5;
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .brand-name {
            font-size: 20px;
            font-weight: 700;
            color: #006B23;
            letter-spacing: -0.5px;
            margin-top: 4px;
        }

        /* Body */
        .body {
            padding: 32px 32px 40px 32px;
        }

        .title {
            font-size: 22px;
            font-weight: 600;
            color: #191C1D;
            margin-top: 0;
            margin-bottom: 24px;
            text-align: center;
        }

        .greeting {
            font-size: 15px;
            font-weight: 600;
            color: #212529;
            margin-bottom: 12px;
        }

        .text {
            font-size: 14px;
            line-height: 22px;
            color: #495057;
            margin-bottom: 20px;
        }

        /* Credentials Box */
        .credentials-box {
            background-color: #F8F9FA;
            border: 1px solid #DEE2E6;
            border-radius: 6px;
            padding: 20px;
            margin: 24px 0;
        }

        .credential-row {
            margin-bottom: 12px;
            font-size: 14px;
        }

        .credential-row:last-child {
            margin-bottom: 0;
        }

        .credential-label {
            font-weight: 600;
            color: #212529;
            display: inline-block;
            width: 100px;
        }

        .credential-value {
            font-family: monospace;
            color: #006B23;
            font-size: 14px;
            background-color: #EDEEEF;
            padding: 2px 6px;
            border-radius: 4px;
        }

        /* Action Button */
        .btn-container {
            text-align: center;
            margin: 30px 0;
        }

        .btn {
            background-color: #006B23;
            color: #FFFFFF !important;
            display: inline-block;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            padding: 12px 28px;
            border-radius: 4px;
            box-shadow: 0 2px 4px rgba(0, 107, 35, 0.15);
            transition: background-color 160ms ease;
        }

        /* Divider */
        .divider {
            border-top: 1px solid #DEE2E6;
            margin: 28px 0;
        }

        /* Helper Info */
        .helper-text {
            font-size: 12px;
            line-height: 18px;
            color: #495057;
        }

        .link-text {
            word-break: break-all;
            color: #2F9E44;
            text-decoration: none;
            font-weight: 500;
        }

        .link-text:hover {
            color: #098730;
        }

        /* Footer */
        .footer {
            background-color: #EDEEEF;
            padding: 24px 32px;
            text-align: center;
            border-top: 1px solid #E9ECEF;
        }

        .footer-text {
            font-size: 12px;
            color: #495057;
            line-height: 18px;
            margin: 0;
        }
    </style>
</head>

<body>
    <center class="wrapper">
        <table class="content-table" role="presentation" cellpadding="0" cellspacing="0">
            <!-- Header -->
            <tr>
                <td class="header">
                    <div class="logo-container">
                        <!-- Handshake SVG matching brand theme -->
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M12.5 13C12.5 13.2761 12.2761 13.5 12 13.5C11.7239 13.5 11.5 13.2761 11.5 13C11.5 12.7239 11.7239 12.5 12 12.5C12.2761 12.5 12.5 12.7239 12.5 13Z"
                                fill="#006B23" stroke="#006B23" stroke-width="1.5" />
                            <path
                                d="M16 14.5C16 15.3284 15.3284 16 14.5 16C13.6716 16 13 15.3284 13 14.5C13 13.6716 13.6716 13 14.5 13C15.3284 13 16 13.6716 16 14.5Z"
                                fill="#006B23" stroke="#006B23" stroke-width="1.5" />
                            <path
                                d="M8.5 11.5C8.5 12.3284 7.82843 13 7 13C6.17157 13 5.5 12.3284 5.5 11.5C5.5 10.6716 6.17157 10 7 10C7.82843 10 8.5 10.6716 8.5 11.5Z"
                                fill="#006B23" stroke="#006B23" stroke-width="1.5" />
                            <path
                                d="M19.5 9.5C19.5 11.3787 18.2574 13.0607 16.5 13.75L15 13C15 13.8284 14.3284 14.5 13.5 14.5H12C11.1716 14.5 10.5 13.8284 10.5 13V12.25L9.5 11.5C7.74264 12.1893 6.5 13.8713 6.5 15.75C6.5 18.3787 8.62132 20.5 11.25 20.5H12.75C15.3787 20.5 17.5 18.3787 17.5 15.75L18.5 15C19.0607 14.4393 19.5 13.25 19.5 12.25V9.5Z"
                                stroke="#006B23" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M4.5 14.5C4.5 11.75 6.75 9.5 9.5 9.5C12.25 9.5 14.5 11.75 14.5 14.5"
                                stroke="#006B23" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path
                                d="M9.5 5.5C9.5 6.88071 8.38071 8 7 8C5.61929 8 4.5 6.88071 4.5 5.5C4.5 4.11929 5.61929 3 7 3C8.38071 3 9.5 4.11929 9.5 5.5Z"
                                fill="#006B23" stroke="#006B23" stroke-width="1.5" />
                            <path
                                d="M19.5 5.5C19.5 6.88071 18.3807 8 17 8C15.6193 8 14.5 6.88071 14.5 5.5C14.5 4.11929 15.6193 3 17 3C18.3807 3 19.5 4.11929 19.5 5.5Z"
                                fill="#006B23" stroke="#006B23" stroke-width="1.5" />
                        </svg>
                    </div>
                    <div class="brand-name">VendorBridge</div>
                </td>
            </tr>

            <!-- Body -->
            <tr>
                <td class="body">
                    <h2 class="title">Account Created</h2>

                    <p class="greeting">Hello <%= typeof vendorname !=='undefined' && vendorname ? vendorname : 'Vendor'
                            %>,</p>

                    <p class="text">
                        Welcome to VendorBridge! Your vendor account has been created by the administrator. Here are
                        your credentials to log in:
                    </p>

                    <div class="credentials-box">
                        <div class="credential-row">
                            <span class="credential-label">Email:</span>
                            <span class="credential-value">
                                <%= typeof email !=='undefined' ? email : '' %>
                            </span>
                        </div>
                        <div class="credential-row">
                            <span class="credential-label">Password:</span>
                            <span class="credential-value">
                                <%= typeof password !=='undefined' ? password : '' %>
                            </span>
                        </div>
                    </div>

                    <p class="text">
                        For security reasons, we recommend that you change your password immediately after logging in
                        for the first time.
                    </p>

                    <div class="btn-container">
                        <a href="<%= typeof loginLink !== 'undefined' ? loginLink : '#' %>" class="btn"
                            target="_blank">Log In to Your Account</a>
                    </div>

                    <div class="divider"></div>

                    <p class="helper-text">
                        If you're having trouble clicking the button, copy and paste the URL below into your web
                        browser:
                    </p>
                    <p class="helper-text" style="margin-top: 6px;">
                        <a href="<%= typeof loginLink !== 'undefined' ? loginLink : '#' %>" class="link-text"
                            target="_blank">
                            <%= typeof loginLink !=='undefined' ? loginLink : '#' %>
                        </a>
                    </p>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td class="footer">
                    <p class="footer-text">
                        This is an automated account setup message from VendorBridge. Please do not reply directly to
                        this email.
                    </p>
                    <p class="footer-text" style="margin-top: 6px; font-weight: 500;">
                        &copy; 2026 VendorBridge. All rights reserved.
                    </p>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>