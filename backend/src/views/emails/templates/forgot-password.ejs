<%- include('../partials/_header.ejs', { title: 'Reset Your Password - VendorBridge' }) %>

            <!-- Body -->
            <tr>
                <td class="body">
                    <h2 class="title">Reset Your Password</h2>

                    <p class="greeting">Hello <%= typeof name !=='undefined' && name ? name : 'User' %>,</p>

                    <p class="text">
                        We received a request to reset the password for your VendorBridge account. No changes have been
                        made to your account yet.
                    </p>

                    <p class="text">
                        You can reset your password by clicking the button below:
                    </p>

                    <div class="btn-container">
                        <a href="<%= typeof resetLink !== 'undefined' ? resetLink : '#' %>" class="btn"
                            target="_blank">Reset Password</a>
                    </div>

                    <p class="text">
                        This link will expire in <strong>
                            <%= typeof expiryTime !=='undefined' ? expiryTime : '2 hours' %>
                        </strong>.
                    </p>

                    <p class="text">
                        If you did not request a password reset, you can safely ignore this email. Your password will
                        remain secure and unchanged.
                    </p>

                    <div class="divider"></div>

                    <p class="helper-text">
                        If you're having trouble clicking the button, copy and paste the URL below into your web
                        browser:
                    </p>
                    <p class="helper-text" style="margin-top: 6px;">
                        <a href="<%= typeof resetLink !== 'undefined' ? resetLink : '#' %>" class="link-text"
                            target="_blank">
                            <%= typeof resetLink !=='undefined' ? resetLink : '#' %>
                        </a>
                    </p>
                </td>
            </tr>

<%- include('../partials/_footer.ejs', { footerNote: 'This is an automated security message from VendorBridge. Please do not reply directly to this email.' }) %>