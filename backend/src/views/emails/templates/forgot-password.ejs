<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password - VendorBridge</title>
    <style>
        /* Base reset & styling */
        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            height: 100% !important;
            background-color: #F3F4F5;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #212529;
            line-height: 1.6;
        }

        table {
            border-collapse: collapse;
        }

        img {
            border: 0;
            outline: none;
            text-decoration: none;
        }

        /* Container */
        .wrapper {
            width: 100%;
            table-layout: fixed;
            background-color: #F3F4F5;
            padding: 48px 0;
        }

        .content-table {
            width: 100%;
            max-width: 460px;
            margin: 0 auto;
            background-color: #FFFFFF;
            border-radius: 8px;
            border: 1px solid #E9ECEF;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            text-align: left;
        }

        /* Header */
        .header {
            background-color: #FFFFFF;
            padding: 40px 32px 20px 32px;
            text-align: center;
            border-bottom: 1px solid #E9ECEF;
        }

        .logo-container {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            background-color: #F3F4F5;
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .brand-name {
            font-size: 20px;
            font-weight: 700;
            color: #006B23;
            letter-spacing: -0.5px;
            margin-top: 4px;
        }

        /* Body */
        .body {
            padding: 32px 32px 40px 32px;
        }

        .title {
            font-size: 22px;
            font-weight: 600;
            color: #191C1D;
            margin-top: 0;
            margin-bottom: 24px;
            text-align: center;
        }

        .greeting {
            font-size: 15px;
            font-weight: 600;
            color: #212529;
            margin-bottom: 12px;
        }

        .text {
            font-size: 14px;
            line-height: 22px;
            color: #495057;
            margin-bottom: 20px;
        }

        /* Action Button */
        .btn-container {
            text-align: center;
            margin: 30px 0;
        }

        .btn {
            background-color: #006B23;
            color: #FFFFFF !important;
            display: inline-block;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            padding: 12px 28px;
            border-radius: 4px;
            box-shadow: 0 2px 4px rgba(0, 107, 35, 0.15);
            transition: background-color 160ms ease;
        }

        /* Divider */
        .divider {
            border-top: 1px solid #DEE2E6;
            margin: 28px 0;
        }

        /* Helper Info */
        .helper-text {
            font-size: 12px;
            line-height: 18px;
            color: #495057;
        }

        .link-text {
            word-break: break-all;
            color: #2F9E44;
            text-decoration: none;
            font-weight: 500;
        }

        .link-text:hover {
            color: #098730;
        }

        /* Footer */
        .footer {
            background-color: #EDEEEF;
            padding: 24px 32px;
            text-align: center;
            border-top: 1px solid #E9ECEF;
        }

        .footer-text {
            font-size: 12px;
            color: #495057;
            line-height: 18px;
            margin: 0;
        }
    </style>
</head>

<body>
    <center class="wrapper">
        <table class="content-table" role="presentation" cellpadding="0" cellspacing="0">
            <!-- Header -->
            <tr>
                <td class="header">
                    <div class="logo-container">
                        <!-- Custom Lock SVG matching theme -->
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="5" y="11" width="14" height="10" rx="2" stroke="#006B23" stroke-width="2" />
                            <path d="M8 11V7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7V11" stroke="#006B23"
                                stroke-width="2" stroke-linecap="round" />
                            <circle cx="12" cy="15" r="1.5" fill="#006B23" />
                            <path d="M12 16.5V18.5" stroke="#006B23" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="brand-name">VendorBridge</div>
                </td>
            </tr>

            <!-- Body -->
            <tr>
                <td class="body">
                    <h2 class="title">Reset Your Password</h2>

                    <p class="greeting">Hello <%= typeof name !=='undefined' && name ? name : 'User' %>,</p>

                    <p class="text">
                        We received a request to reset the password for your VendorBridge account. No changes have been
                        made to your account yet.
                    </p>

                    <p class="text">
                        You can reset your password by clicking the button below:
                    </p>

                    <div class="btn-container">
                        <a href="<%= typeof resetLink !== 'undefined' ? resetLink : '#' %>" class="btn"
                            target="_blank">Reset Password</a>
                    </div>

                    <p class="text">
                        This link will expire in <strong>
                            <%= typeof expiryTime !=='undefined' ? expiryTime : '2 hours' %>
                        </strong>.
                    </p>

                    <p class="text">
                        If you did not request a password reset, you can safely ignore this email. Your password will
                        remain secure and unchanged.
                    </p>

                    <div class="divider"></div>

                    <p class="helper-text">
                        If you're having trouble clicking the button, copy and paste the URL below into your web
                        browser:
                    </p>
                    <p class="helper-text" style="margin-top: 6px;">
                        <a href="<%= typeof resetLink !== 'undefined' ? resetLink : '#' %>" class="link-text"
                            target="_blank">
                            <%= typeof resetLink !=='undefined' ? resetLink : '#' %>
                        </a>
                    </p>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td class="footer">
                    <p class="footer-text">
                        This is an automated security message from VendorBridge. Please do not reply directly to this
                        email.
                    </p>
                    <p class="footer-text" style="margin-top: 6px; font-weight: 500;">
                        &copy; 2026 VendorBridge. All rights reserved.
                    </p>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>